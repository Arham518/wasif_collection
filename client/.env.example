# Copy this file to ".env.local" (it is gitignored) and fill in your values.
# Supabase dashboard -> Project Settings -> API -> Project URL and anon public key.
# These VITE_ variables are baked into the site at build time (npm run build).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY